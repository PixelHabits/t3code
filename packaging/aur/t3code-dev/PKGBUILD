# Maintainer: PixelHabits
# Personal build of the fork's dev branch. Not for the AUR: prepare() and
# build() need network for pnpm and the Electron download.

pkgname=t3code-dev
pkgver=0.0.40.r3903.g0c5771d60
pkgrel=1
pkgdesc='Desktop control surface for local coding agents (PixelHabits dev branch)'
arch=('x86_64')
url='https://github.com/PixelHabits/t3code'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
# node >= 24 and pnpm come from the builder's toolchain (fnm), so they are
# not listed. prepare() checks for them.
makedepends=('git' 'cargo' 'pkgconf' 'libsecret' 'imagemagick')
optdepends=('openai-codex: use the system-installed Codex CLI')
provides=('t3code')
conflicts=('t3code' 't3code-bin' 't3code-nightly-bin')
options=('!debug' '!strip')

_branch=dev
source=("t3code::git+https://github.com/PixelHabits/t3code.git#branch=${_branch}")
sha256sums=('SKIP')

pkgver() {
  cd t3code
  local app_version
  app_version="$(node -p "require('./apps/desktop/package.json').version")"
  printf '%s.r%s.g%s' "$app_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd t3code
  local node_major
  node_major="$(node -p 'process.versions.node.split(".")[0]')"
  if (( node_major < 24 )); then
    echo "node >= 24 is required, found $(node --version)" >&2
    return 1
  fi
  command -v pnpm >/dev/null || { echo 'pnpm is required on PATH' >&2; return 1; }
  pnpm install --frozen-lockfile --prefer-offline --ignore-scripts
}

build() {
  cd t3code
  export PATH="$PWD/node_modules/.bin:$PATH"
  # dir = electron-builder's unpacked tree, the same files an AppImage wraps.
  # The script only copies files out of its stage, so keep the stage in a
  # known TMPDIR and read the tree from there.
  export TMPDIR="$srcdir/stage"
  rm -rf "$TMPDIR" && mkdir -p "$TMPDIR"
  T3CODE_DESKTOP_KEEP_STAGE=true \
    node scripts/build-desktop-artifact.ts --platform linux --target dir --arch x64

  local unpacked
  unpacked="$(find "$TMPDIR" -maxdepth 4 -type d -name linux-unpacked -print -quit)"
  if [[ -z $unpacked || ! -x $unpacked/t3code || ! -f $unpacked/chrome-sandbox ]]; then
    echo 'No linux-unpacked tree with launcher and Chromium sandbox was produced.' >&2
    return 1
  fi
  rm -rf "$srcdir/linux-unpacked"
  mv "$unpacked" "$srcdir/linux-unpacked"

  # Same sizes the upstream Linux build stages for hicolor.
  local size
  for size in 16 22 24 32 48 64 128 256 512; do
    magick assets/prod/black-universal-1024.png -resize "${size}x${size}" "$srcdir/icon-${size}.png"
  done
}

package() {
  cd t3code
  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/linux-unpacked/." "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3code" <<'SH'
#!/bin/sh
exec /opt/t3code-dev/t3code "$@"
SH
  ln -s t3code "$pkgdir/usr/bin/t3-code-desktop"

  local size
  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "$srcdir/icon-${size}.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/t3code.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code.desktop" <<'DESKTOP'
[Desktop Entry]
Name=T3 Code
Comment=Desktop control surface for local coding agents
Exec=t3code %U
TryExec=t3code
Terminal=false
Type=Application
Icon=t3code
StartupWMClass=t3code
Categories=Development;
MimeType=x-scheme-handler/t3code;
DESKTOP

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
